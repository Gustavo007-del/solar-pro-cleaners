# Public API identity. API_PREFIX and API_VERSION combine into /api/v1 by default.
APP_NAME="Solar Care API"
APP_ENVIRONMENT=development
DEBUG=false
API_VERSION=v1
API_PREFIX=/api
# Optional override in development. Disabled in staging and production.
DOCS_ENABLED=

# Use a Supabase PostgreSQL connection URI for the backend role. Percent-encode
# special characters in credentials. Keep this value on the server.
# Staging and production require DATABASE_URL and default to sslmode=require.
# Prefer sslmode=verify-full with the trusted CA configured in production.
DATABASE_URL=
# Optional direct or session-pooler migration connection. Required if the app
# uses the transaction pooler. Keep migration credentials separate from the app role.
MIGRATION_DATABASE_URL=

# direct, session, or transaction. Transaction mode disables driver prepared
# statements and uses Supabase's pool rather than a second application pool.
DB_CONNECTION_MODE=direct
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5

# JSON arrays. Deployed environments require exact hosts and HTTPS browser origins.
TRUSTED_HOSTS=[]
TRUSTED_PROXY_IPS=[]
ALLOWED_CORS_ORIGINS=[]
# DEBUG, INFO, WARNING, ERROR, CRITICAL. Blank uses DEBUG or INFO from DEBUG above.
LOG_LEVEL=

# python -m app.serve requires APP_ENVIRONMENT in the process environment.
HOST=0.0.0.0
PORT=8000
WEB_WORKERS=1
WEB_CONCURRENCY=64
GRACEFUL_SHUTDOWN_SECONDS=30
REQUEST_MAX_BYTES=65536

# Server-only CSPRNG secret. Required in production. HS256, HS384, and HS512
# require at least 32, 48, and 64 UTF-8 bytes respectively.
JWT_SIGNING_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=solar-care-api
JWT_AUDIENCE=solar-care-customers
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Administrative authentication has an independent signing key and claims.
# Required in staging and production. Optional in development.
ADMIN_JWT_SIGNING_SECRET=
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_ISSUER=solar-care-admin-api
ADMIN_JWT_AUDIENCE=solar-care-admin
ADMIN_ACCESS_TOKEN_MINUTES=10
ADMIN_REFRESH_TOKEN_DAYS=7
ADMIN_PASSWORD_MIN_LENGTH=15
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_ATTEMPTS_PER_PAIR=5
ADMIN_LOGIN_ATTEMPTS_PER_SOURCE=30
ADMIN_LOGIN_ATTEMPTS_PER_ACCOUNT=20
# Exact HTTPS origins for browser cookie mode. Also list them in ALLOWED_CORS_ORIGINS.
ADMIN_BROWSER_ORIGINS=[]
ADMIN_COOKIE_SECURE=true

# Independent CSPRNG secret of at least 32 bytes. Required in staging and production.
RATE_LIMIT_SECRET=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CUSTOMER_REGISTER=10
RATE_LIMIT_CUSTOMER_LOGIN=20
RATE_LIMIT_CUSTOMER_REFRESH=60
RATE_LIMIT_ADMIN_REFRESH=30
RATE_LIMIT_BOOKING_CREATE=20
RATE_LIMIT_BOOKING_CANCEL=20
RATE_LIMIT_CUSTOMER_UPDATE=30
RATE_LIMIT_ADMIN_CREATE=10
RATE_LIMIT_ADMIN_PASSWORD=5

# Fallback when an active business profile does not supply its timezone.
BUSINESS_TIMEZONE=Asia/Kolkata
# Set YYYY-MM-DD after approving the policy. Blank displays the draft.
PUBLIC_PRIVACY_EFFECTIVE_DATE=
PRIVATE_MEDIA_BUCKET=
PRIVATE_MEDIA_MAX_BYTES=5242880
# Phase 13: separate PostgreSQL notification worker. Set the token only when using Expo push security.
# EXPO_PUSH_ACCESS_TOKEN=
NOTIFICATION_POLL_SECONDS=3
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_CLAIM_LIMIT=10
NOTIFICATION_RETRY_LIMIT=4
NOTIFICATION_RECEIPT_RETRY_LIMIT=6
NOTIFICATION_RECEIPT_DELAY_SECONDS=900
NOTIFICATION_HTTP_TIMEOUT_SECONDS=10
NOTIFICATION_MIN_INTERVAL_MINUTES=15
RATE_LIMIT_NOTIFICATION_DEVICE=120
RATE_LIMIT_NOTIFICATION_ACTION=30
