# Public API identity. API_PREFIX and API_VERSION combine into /api/v1 by default.
APP_NAME="Solar Care API"
APP_ENVIRONMENT=development
DEBUG=false
API_VERSION=v1
API_PREFIX=/api
# Optional override. Defaults to enabled in development and disabled in production.
DOCS_ENABLED=

# Use a Supabase PostgreSQL connection URI for the backend role. Percent-encode
# special characters in credentials. Keep this value on the server.
# Production requires DATABASE_URL and defaults to sslmode=require.
# Prefer sslmode=verify-full with the trusted CA configured in production.
DATABASE_URL=
# Optional direct or session-pooler migration connection. Required if the app
# uses the transaction pooler. Keep migration credentials separate from the app role.
MIGRATION_DATABASE_URL=

# direct, session, or transaction. Transaction mode disables driver prepared
# statements and uses Supabase's pool rather than a second application pool.
DB_CONNECTION_MODE=direct
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5

# JSON array of exact browser origins. Replace localhost for the deployed admin.
ALLOWED_CORS_ORIGINS='["http://localhost:3000"]'
# DEBUG, INFO, WARNING, ERROR, CRITICAL. Blank uses DEBUG or INFO from DEBUG above.
LOG_LEVEL=

# Server-only CSPRNG secret. Required in production. HS256, HS384, and HS512
# require at least 32, 48, and 64 UTF-8 bytes respectively.
JWT_SIGNING_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=solar-care-api
JWT_AUDIENCE=solar-care-customers
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Administrative authentication has an independent signing key and claims.
# Leave unset to keep admin authentication unavailable.
ADMIN_JWT_SIGNING_SECRET=
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_ISSUER=solar-care-admin-api
ADMIN_JWT_AUDIENCE=solar-care-admin
ADMIN_ACCESS_TOKEN_MINUTES=10
ADMIN_REFRESH_TOKEN_DAYS=7
ADMIN_PASSWORD_MIN_LENGTH=15
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_ATTEMPTS_PER_PAIR=5
ADMIN_LOGIN_ATTEMPTS_PER_SOURCE=30
ADMIN_LOGIN_ATTEMPTS_PER_ACCOUNT=20
# Exact HTTPS origins for browser cookie mode. Also list them in ALLOWED_CORS_ORIGINS.
ADMIN_BROWSER_ORIGINS=[]
ADMIN_COOKIE_SECURE=true
