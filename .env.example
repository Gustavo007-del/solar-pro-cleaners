# EAS profiles select their own environment and set this value for each build.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=
EXPO_PUBLIC_APP_NAME_ML=
ANDROID_APPLICATION_ID=
ANDROID_TARGET_SDK=
EXPO_OWNER=
EAS_PROJECT_ID=
# Full versioned API base (for example https://api.example.com/api/v1).
# Public build-time value. Use separate values for development and production.
EXPO_PUBLIC_API_BASE_URL=
# Contact information, operating hours and closures come from the FastAPI business configuration.
EXPO_PUBLIC_BUSINESS_LEGAL_NAME=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
# Android FCM client config for local native builds (optional until configuring push):
# GOOGLE_SERVICES_JSON=./google-services.json
# For EAS builds, set GOOGLE_SERVICES_JSON as a file variable in the matching EAS environment.
